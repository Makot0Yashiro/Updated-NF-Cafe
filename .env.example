# Copy this file to .env for local development (.env is git-ignored and loaded automatically).
# On Render, set these in the service's Environment tab instead (render.yaml lists them).

# "production" turns on secure cookies and HTTPS handling, and makes SECRET_KEY / ADMIN_PASSWORD required.
APP_ENV=development

# Long random string that signs logins. Required in production; locally one is made in instance/secret_key if empty.
SECRET_KEY=

# --- Database: either one URL (hosted MySQL) ...
# DATABASE_URL=mysql://user:password@host:3306/nf_cafe
# ... or separate values (local MySQL, same as your MySQL Workbench connection):
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nf_cafe

# Hosted MySQL usually needs SSL. Best: the provider's CA certificate file (verifies the server).
# MYSQL_SSL_CA=/etc/secrets/ca.pem
# Or, without a CA file (encrypted, server not verified):
# MYSQL_SSL=required

# First admin account, created only while the database has no admin. Required in production.
ADMIN_EMAIL=admin@newfoundcafe.com
ADMIN_PASSWORD=

# SMTP for the OTP emails. Leave MAIL_USERNAME empty to print codes in the terminal instead.
# Gmail: turn on 2-Step Verification and create an App password (myaccount.google.com/apppasswords).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_SENDER=no-reply@example.com
